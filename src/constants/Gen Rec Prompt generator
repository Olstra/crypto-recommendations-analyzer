import os
from itertools import combinations
from itertools import product
import re

model_role_list = ['You are a recommender system that help users with investment planning.']

scenario_list = ['I have {budget} CHF to invest.',
                 'My risk tolerance is {risk}.',
                 'My investment term is {term}.',
                 'The market environment is {env}.',
                 'I tend to invest in {category}']

requirements = [
                'Please recommend a cryptocurrency investment plan to me, specifying the name of the cryptocurrency, sorted by the level of recommendation.',
                ' Only output the token crypto currency short name and the corresponding investment amount. No explanation, no other information. The output format is token ticker: investment amount.']

attribute_dict = {
                '{budget}':['10,000', '20,000', '30,000', '40,000', '50,000', '100,000'],
                '{risk}':['risk averse', 'risk neutral'],
                '{term}':['less than one year', 'one to three years', 'three to ten years', 'more than ten years'],
                '{env}':['expansion', 'crisis', 'recession', 'recovery'],
                '{category}':['Large Cap', 'Medium Cap', 'Small Cap']
                }

attribute_list = ['budget', 'risk', 'term', 'env', 'category']

scenario_index_list = list(range(len(scenario_list)))

# --- Build every template: one per (role, subset of scenario attributes) ---
all_templates = []
file_name_list = []
for role_idx, role in enumerate(model_role_list):
    for r in range(0, len(scenario_index_list) + 1):
        for combo in combinations(scenario_index_list, r):
            # Name the output file after which attributes are included
            if len(combo) == 0:
                file_name = 'no_fair_no_scenario' if role_idx == 0 else 'fair_no_scenario'
            else:
                prefix = 'no_fair_' if role_idx == 0 else 'fair_'
                file_name = prefix + '-'.join([attribute_list[ii] for ii in combo])
            file_name_list.append(file_name)

            # Assemble the scenario text from the chosen attributes
            scenario_combina_list = [scenario_list[idx] for idx in combo]
            tmp_scenario = ' '.join(scenario_combina_list) if scenario_combina_list else ''

            # If 'budget' (index 0) is included, use the fuller requirements string;
            # otherwise use the terse ticker:amount-only instruction
            if 0 in combo:
                tmp_scenario = role + ' ' + tmp_scenario + ' ' + requirements[0]
            else:
                tmp_scenario = role + ' ' + tmp_scenario + ' ' + requirements[1]

            all_templates.append(tmp_scenario)

# --- Expand each template into concrete prompts by substituting attribute values ---
all_prompts = []
for idx, template in enumerate(all_templates):
    prompts = []
    keys_in_template = list(set(re.findall(r'\{.*?\}', template)))
    values = [attribute_dict[key] for key in keys_in_template]

    attr_combinations = product(*values)
    for combination in attr_combinations:
        prompt = template
        for key, value in zip(keys_in_template, combination):
            prompt = prompt.replace(key, value)
        prompts.append(prompt)
        all_prompts.append(prompt)

    save_dir = 'cryptocurrency_v1_prompts'
    if not os.path.exists(save_dir):
        os.makedirs(save_dir)
    with open(os.path.join(save_dir, '%s_%s.txt' % (file_name_list[idx], len(prompts))), 'w') as f:
        for prp in prompts:
            f.write(prp + '\n')

print(len(all_prompts))
